# Reserved for a future cloud control plane — the current static web app does
# not read these values yet. Local analysis works without them.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AGENT_DEFAULT_URL=http://127.0.0.1:8787

# Local Agent
BML_AGENT_HOST=127.0.0.1
BML_AGENT_PORT=8787
BML_AGENT_DATA_DIR=./data
BML_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
BML_SUPABASE_ANON_KEY=your-anon-key

# Optional BYOK is stored only in Local Agent secure store — never put provider keys here for production users
