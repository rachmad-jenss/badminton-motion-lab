    "footwork:pure": {
      "requiredArtifacts": ["pose", "events", "metrics"],
      "requiresCourt": true
    },
    "footwork:layer:*": {
      "requiredArtifacts": ["pose", "events", "metrics"],
      "requiresCourt": true
    }
  }
}
