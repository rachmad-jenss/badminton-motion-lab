    "minProposalConfidence": 0.55,
    "requiresCourtForFootwork": true,
    "requiresRacket": true,
    "requiresShuttle": true,
    "fixturePassRate": 1.0
  },
  "modules": {
    "technique:*": {
      "requiredArtifacts": ["pose", "racket", "shuttle", "events", "metrics"],
      "benchmark": "validation/reports/technique__{stroke}.json"
